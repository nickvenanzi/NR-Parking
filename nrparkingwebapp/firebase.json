{
  "hosting": [
    {
      "target": "parking",
      "public": "build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "verification",
      "public": "verification/build",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/verification/**",
          "destination": "/verification/index.html"
        }
      ]
    }
  ]
}